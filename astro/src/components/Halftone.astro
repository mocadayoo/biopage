---
interface Props {
    spacing?: number;
    baseRadius?: number;
    influenceRadius?: number;
    maxScale?: number;

    mouseLerpSpeed?: number;
    radiusLerpSpeed?: number;

    velocityLerpSpeed?: number;
    velocityDecay?: number;
}

const {
    spacing = 18,
    baseRadius = 0.5,
    influenceRadius = 140,
    maxScale = 12,

    mouseLerpSpeed = 8,
    radiusLerpSpeed = 8,

    velocityLerpSpeed = 10,
    velocityDecay = 0.0012,
} = Astro.props;
---

<canvas
    class="halftone pointer-events-none absolute inset-0 h-full w-full"
    data-spacing={spacing}
    data-base-radius={baseRadius}
    data-influence-radius={influenceRadius}
    data-max-scale={maxScale}
    data-mouse-lerp-speed={mouseLerpSpeed}
    data-radius-lerp-speed={radiusLerpSpeed}
    data-velocity-lerp-speed={velocityLerpSpeed}
    data-velocity-decay={velocityDecay}></canvas>

<script>
    const vertexShaderSource = `#version 300 es
precision highp float;

void main() {
  vec2 positions[3] = vec2[](
    vec2(-1.0, -1.0),
    vec2( 3.0, -1.0),
    vec2(-1.0,  3.0)
  );

  gl_Position = vec4(positions[gl_VertexID], 0.0, 1.0);
}
`;

    const fragmentShaderSource = `#version 300 es
precision highp float;

uniform vec2 uResolution;
uniform vec2 uMouse;

uniform float uDpr;
uniform float uSpacing;
uniform float uBaseRadius;
uniform float uInfluenceRadius;
uniform float uMaxScale;
uniform float uMouseInfluence;

uniform float uMouseVelocity;
uniform float uVelocityDecay;

out vec4 outColor;

void main() {
  vec2 pos = gl_FragCoord.xy / uDpr;
  pos.y = uResolution.y - pos.y;

  vec2 cell = mod(pos, uSpacing) - uSpacing * 0.5;
  float dotDistance = length(cell);

  float influence =
    1.0 - smoothstep(
      0.0,
      uInfluenceRadius,
      distance(pos, uMouse)
    );

  influence *= uMouseInfluence;
  influence *= influence;

  float growthStrength = exp(-uMouseVelocity * uVelocityDecay);

  float radius =
    uBaseRadius *
    mix(
      1.0,
      uMaxScale,
      influence * growthStrength
    );

  float aa = max(fwidth(dotDistance), 0.5);

  float alpha =
    1.0 - smoothstep(
      radius - aa,
      radius + aa,
      dotDistance
    );

  outColor = vec4(
    1.0,
    1.0,
    1.0,
    alpha * 0.35
  );
}
`;

    const createShader = (
        gl: WebGL2RenderingContext,
        type: number,
        source: string,
    ) => {
        const shader = gl.createShader(type);

        if (!shader) {
            throw new Error("Failed to create shader");
        }

        gl.shaderSource(shader, source);
        gl.compileShader(shader);

        if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
            const error = gl.getShaderInfoLog(shader);

            gl.deleteShader(shader);

            throw new Error(error ?? "Failed to compile shader");
        }

        return shader;
    };

    const createProgram = (
        gl: WebGL2RenderingContext,
        vertexSource: string,
        fragmentSource: string,
    ) => {
        const vertexShader = createShader(gl, gl.VERTEX_SHADER, vertexSource);

        const fragmentShader = createShader(
            gl,
            gl.FRAGMENT_SHADER,
            fragmentSource,
        );

        const program = gl.createProgram();

        if (!program) {
            throw new Error("Failed to create WebGL program");
        }

        gl.attachShader(program, vertexShader);
        gl.attachShader(program, fragmentShader);
        gl.linkProgram(program);

        gl.deleteShader(vertexShader);
        gl.deleteShader(fragmentShader);

        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
            const error = gl.getProgramInfoLog(program);

            gl.deleteProgram(program);

            throw new Error(error ?? "Failed to link WebGL program");
        }

        return program;
    };

    const damp = (
        current: number,
        target: number,
        speed: number,
        deltaTime: number,
    ) => {
        const t = 1 - Math.exp(-speed * deltaTime);

        return current + (target - current) * t;
    };

    document
        .querySelectorAll<HTMLCanvasElement>(".halftone")
        .forEach((canvas) => {
            const gl = canvas.getContext("webgl2", {
                alpha: true,
                antialias: false,
                premultipliedAlpha: false,
            });

            if (!gl) {
                console.error("WebGL2 is not supported");
                return;
            }

            const program = createProgram(
                gl,
                vertexShaderSource,
                fragmentShaderSource,
            );

            gl.useProgram(program);
            gl.clearColor(0, 0, 0, 0);

            const uniform = {
                resolution: gl.getUniformLocation(program, "uResolution"),
                mouse: gl.getUniformLocation(program, "uMouse"),

                dpr: gl.getUniformLocation(program, "uDpr"),
                spacing: gl.getUniformLocation(program, "uSpacing"),
                baseRadius: gl.getUniformLocation(program, "uBaseRadius"),
                influenceRadius: gl.getUniformLocation(
                    program,
                    "uInfluenceRadius",
                ),
                maxScale: gl.getUniformLocation(program, "uMaxScale"),
                mouseInfluence: gl.getUniformLocation(
                    program,
                    "uMouseInfluence",
                ),

                mouseVelocity: gl.getUniformLocation(program, "uMouseVelocity"),
                velocityDecay: gl.getUniformLocation(program, "uVelocityDecay"),
            };

            const spacing = Number(canvas.dataset.spacing);
            const baseRadius = Number(canvas.dataset.baseRadius);
            const influenceRadius = Number(canvas.dataset.influenceRadius);
            const maxScale = Number(canvas.dataset.maxScale);

            const mouseLerpSpeed = Number(canvas.dataset.mouseLerpSpeed);
            const radiusLerpSpeed = Number(canvas.dataset.radiusLerpSpeed);

            const velocityLerpSpeed = Number(canvas.dataset.velocityLerpSpeed);
            const velocityDecay = Number(canvas.dataset.velocityDecay);

            let width = 0;
            let height = 0;
            let dpr = 1;

            let mouseActive = false;

            let targetMouseX = 0;
            let targetMouseY = 0;

            let currentMouseX = 0;
            let currentMouseY = 0;

            let previousMouseX = 0;
            let previousMouseY = 0;

            let mouseVelocity = 0;
            let currentInfluence = 0;

            let lastTime = performance.now();

            gl.uniform1f(uniform.spacing, spacing);
            gl.uniform1f(uniform.baseRadius, baseRadius);
            gl.uniform1f(uniform.influenceRadius, influenceRadius);
            gl.uniform1f(uniform.maxScale, maxScale);
            gl.uniform1f(uniform.velocityDecay, velocityDecay);

            const resize = () => {
                const rect = canvas.getBoundingClientRect();

                width = rect.width;
                height = rect.height;

                dpr = Math.min(window.devicePixelRatio || 1, 2);

                const pixelWidth = Math.round(width * dpr);
                const pixelHeight = Math.round(height * dpr);

                if (
                    canvas.width === pixelWidth &&
                    canvas.height === pixelHeight
                ) {
                    return;
                }

                canvas.width = pixelWidth;
                canvas.height = pixelHeight;

                gl.viewport(0, 0, canvas.width, canvas.height);

                gl.uniform2f(uniform.resolution, width, height);

                gl.uniform1f(uniform.dpr, dpr);
            };

            const resizeObserver = new ResizeObserver(resize);

            resizeObserver.observe(canvas);
            resize();

            window.addEventListener("mousemove", (event) => {
                const rect = canvas.getBoundingClientRect();

                const x = event.clientX - rect.left;
                const y = event.clientY - rect.top;

                const inside =
                    x >= 0 && x <= rect.width && y >= 0 && y <= rect.height;

                if (!inside) {
                    mouseActive = false;
                    return;
                }

                targetMouseX = x;
                targetMouseY = y;

                if (!mouseActive) {
                    currentMouseX = x;
                    currentMouseY = y;

                    previousMouseX = x;
                    previousMouseY = y;

                    mouseVelocity = 0;
                }

                mouseActive = true;
            });

            document.documentElement.addEventListener("mouseleave", () => {
                mouseActive = false;
            });

            window.addEventListener("blur", () => {
                mouseActive = false;
            });

            const draw = (time: number) => {
                const deltaTime = Math.min((time - lastTime) / 1000, 0.1);

                lastTime = time;

                currentMouseX = damp(
                    currentMouseX,
                    targetMouseX,
                    mouseLerpSpeed,
                    deltaTime,
                );

                currentMouseY = damp(
                    currentMouseY,
                    targetMouseY,
                    mouseLerpSpeed,
                    deltaTime,
                );

                const dx = currentMouseX - previousMouseX;
                const dy = currentMouseY - previousMouseY;

                const rawVelocity =
                    Math.hypot(dx, dy) / Math.max(deltaTime, 0.001);

                mouseVelocity = damp(
                    mouseVelocity,
                    mouseActive ? rawVelocity : 0,
                    velocityLerpSpeed,
                    deltaTime,
                );

                previousMouseX = currentMouseX;
                previousMouseY = currentMouseY;

                currentInfluence = damp(
                    currentInfluence,
                    mouseActive ? 1 : 0,
                    radiusLerpSpeed,
                    deltaTime,
                );

                gl.uniform2f(uniform.mouse, currentMouseX, currentMouseY);

                gl.uniform1f(uniform.mouseInfluence, currentInfluence);

                gl.uniform1f(uniform.mouseVelocity, mouseVelocity);

                gl.drawArrays(gl.TRIANGLES, 0, 3);

                requestAnimationFrame(draw);
            };

            requestAnimationFrame(draw);
        });
</script>
