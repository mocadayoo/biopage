<script>
    import { gsap } from "gsap";
    import { SplitText } from "gsap/SplitText";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(SplitText, ScrollTrigger);

    gsap.context(() => {
        const split = SplitText.create("#aboutMe", {
            type: "chars",
        });

        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: "#aboutMe",
                start: "top 40%",
                once: true,
            },
        });

        tl.fromTo(
            split.chars,
            {
                yPercent: 140,
                rotate: 4,
                opacity: 0,
            },
            {
                yPercent: 0,
                rotate: 0,
                opacity: 1,
                duration: 0.65,
                ease: "elastic.out(0.75, 0.5)",
                stagger: {
                    each: 0.025,
                    from: "start",
                },
            },
        );

        tl.to(
            "#aboutMe",
            {
                opacity: 0,
                duration: 0.5,
                ease: "power2.out",
            },
            "+=0.2",
        );
    });
</script>
